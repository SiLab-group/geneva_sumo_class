<?xml version="1.0" encoding="UTF-8"?>
<!-- control_panel.py builds the network and passes the routes (-r) -->
<configuration>
    <input>
        <net-file value="net/geneva_merge.net.xml"/>
    </input>

    <report>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="gui.view.xml"/>
    </gui_only>
</configuration>
