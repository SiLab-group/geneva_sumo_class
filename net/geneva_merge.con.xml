<?xml version="1.0" encoding="UTF-8"?>
<!-- Lane-to-lane connections. Lane 0 is the rightmost lane.
     The ramp feeds the acceleration lane (accel_0), which ends at n2:
     ramp vehicles must change left before it ends - this is where congestion starts. -->
<connections>
    <connection from="ramp_in"    to="ramp_merge" fromLane="0" toLane="0"/>

    <connection from="main_up"    to="accel"      fromLane="0" toLane="1"/>
    <connection from="main_up"    to="accel"      fromLane="1" toLane="2"/>
    <connection from="main_up"    to="accel"      fromLane="2" toLane="3"/>
    <connection from="ramp_merge" to="accel"      fromLane="0" toLane="0"/>

    <connection from="accel"      to="main_down"  fromLane="1" toLane="0"/>
    <connection from="accel"      to="main_down"  fromLane="2" toLane="1"/>
    <connection from="accel"      to="main_down"  fromLane="3" toLane="2"/>
</connections>
