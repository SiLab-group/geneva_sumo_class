<?xml version="1.0" encoding="UTF-8"?>
<!-- Induction loops (like the FEDRO traffic counters on the Geneva motorway).
     up_*   : 300 m before the merge  -> shows the queue growing backwards
     down_* : 100 m after the acceleration lane -> input for ALINEA ramp metering -->
<additional>
    <inductionLoop id="up_0"   lane="main_up_0"   pos="700"  period="60" file="out/loops.xml"/>
    <inductionLoop id="up_1"   lane="main_up_1"   pos="700"  period="60" file="out/loops.xml"/>
    <inductionLoop id="up_2"   lane="main_up_2"   pos="700"  period="60" file="out/loops.xml"/>

    <inductionLoop id="down_0" lane="main_down_0" pos="100"  period="60" file="out/loops.xml"/>
    <inductionLoop id="down_1" lane="main_down_1" pos="100"  period="60" file="out/loops.xml"/>
    <inductionLoop id="down_2" lane="main_down_2" pos="100"  period="60" file="out/loops.xml"/>
</additional>
